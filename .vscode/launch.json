{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run chat-api (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "chat_api.serve",
      "cwd": "${workspaceFolder}/apps/chat-api",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/chat-api/src"
      },
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Run Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "args": [
        "-q"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/apps/chat-api/src"
      },
      "justMyCode": true
    },
    {
      "name": "Install Dependencies",
      "type": "debugpy",
      "request": "launch",
      "module": "pip",
      "cwd": "${workspaceFolder}/apps/chat-api",
      "args": [
        "install",
        "-e",
        ".[dev]"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}

